// tsconfig.node.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "lib": ["esnext"],
    "composite": true,
    "rootDir": "./electron",
    "outDir": "./dist-electron"
  },
  "include": ["electron/**/*"],
  "exclude": ["dist-electron", "dist", "node_modules"]
}