{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
  },
  "include": ["src/**/*.tsx", "src/**/*.ts"]
}