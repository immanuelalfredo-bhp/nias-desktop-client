{
  "name": "@nias/desktop-client",
  "version": "0.0.5",
  "type": "module",
  "author": "Immanuel Alfredo",
  "description": "NIAS Desktop Client Application",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "shared:local": "node ./scripts/set-shared-source.mjs local",
    "shared:github": "node ./scripts/set-shared-source.mjs github",
    "prepare:shared": "node ./scripts/prepare-shared-package.mjs",
    "build:vite": "vite build",
    "build:shared": "npm run build --workspace=@nias/shared",
    "build": "npm run shared:local && npm run build:shared && npm run prepare:shared && vite build",
    "release": "npm run shared:local && npm run build:shared && npm run prepare:shared && vite build && electron-builder --publish always",
    "dev": "vite",
    "start": "npm run build && electron ."
  },
  "build": {
    "appId": "NiasClient",
    "productName": "NI Auxiliary System",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      {
        "from": "../nias-shared",
        "to": "node_modules/@nias/shared",
        "filter": [
          "package.json",
          "dist/**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "immanuelalfredo-bhp",
      "repo": "nias-desktop-client",
      "private": false,
      "releaseType": "release"
    },
    "nsis": {
      "perMachine": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@nias/shared": "file:../nias-shared",
    "axios": "^1.18.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "42.4.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.0.4"
  }
}
